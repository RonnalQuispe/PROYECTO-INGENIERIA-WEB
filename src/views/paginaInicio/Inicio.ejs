<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdminExpress - Inicio</title>
    <link rel="stylesheet" href="/css/styleApp.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="app-body">

    <header>
        <%- include('../partials/navbar') %>
    </header>

    <main class="app-main">
        <section class="container">

            <header class="page-header">
                <h1>👋 Bienvenido, <strong><%= usuario %></strong></h1>
            </header>

            <section class="cards-grid">

                <article class="card info">
                    <div class="card-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <div class="card-info">
                        <h2>Ver Ventas</h2>
                        <p>Consulta y filtra todos los pedidos registrados</p>
                    </div>
                    <footer>
                        <a href="/ventas" class="card-link">Ir al listado →</a>
                    </footer>
                </article>

                <article class="card info">
                    <div class="card-icon">
                        <i class="fa-solid fa-circle-plus"></i>
                    </div>
                    <div class="card-info">
                        <h2>Nueva Venta</h2>
                        <p>Registra un nuevo pedido del catálogo</p>
                    </div>
                    <footer>
                        <a href="/ventas/crear" class="card-link">Registrar →</a>
                    </footer>
                </article>

                <article class="card info">
                    <div class="card-icon">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div class="card-info">
                        <h2>Cartera</h2>
                        <p>Saldos pendientes y estado de cobros por cliente</p>
                    </div>
                    <footer>
                        <a href="/cartera" class="card-link">Ver cartera →</a>
                    </footer>
                </article>

                <article class="card info">
                    <div class="card-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div class="card-info">
                        <h2>Reportes</h2>
                        <p>Dashboard analítico con KPIs y tendencias</p>
                    </div>
                    <footer>
                        <a href="/reportes" class="card-link">Ver reportes →</a>
                    </footer>
                </article>

            </section>

        </section>
    </main>

</body>
</html>
