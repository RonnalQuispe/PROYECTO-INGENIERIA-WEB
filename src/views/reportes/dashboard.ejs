<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <link rel="stylesheet" href="/css/styleIndex.css">
    <link rel="stylesheet" href="/css/styleApp.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="app-body">

    <%- include('../partials/navbar') -%>

    <main class="app-main">
        <div class="container">

            <header class="page-header">
                <h1><i class="fa-solid fa-chart-line"></i> Dashboard Analítico</h1>
                <span style="color:#95a5a6;font-size:14px;">Sistema Jalej</span>
            </header>

            <!-- Espacio reservado para reportes -->
            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:400px;background:#fff;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.06);padding:40px;text-align:center;">
                <i class="fa-solid fa-chart-pie" style="font-size:64px;color:#e5e7eb;margin-bottom:20px;"></i>
                <h2 style="color:#2c3e50;margin:0 0 8px;">Reportes en construcción</h2>
                <p style="color:#95a5a6;margin:0;">Esta sección está siendo configurada.</p>
            </div>

        </div>
    </main>

</body>
</html>
