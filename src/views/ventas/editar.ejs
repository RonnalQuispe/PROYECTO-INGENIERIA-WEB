<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdminExpress - Editar Venta</title>
    <link rel="stylesheet" href="/css/styleApp.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="app-body">

    <%- include('../partials/navbar') %>

    <main class="app-main">
        <div class="container container-sm">

            <div class="page-header">
                <h1><i class="fa-solid fa-pen-to-square"></i> Editar Venta</h1>
                <a href="/ventas" class="btn-secondary">← Volver al listado</a>
            </div>

            <% if (error) { %>
                <div class="alert-error"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
            <% } %>

            <div class="form-card">
                <form action="/ventas/editar/<%= venta._id %>" method="POST">

                    <!-- Zona -->
                    <div class="input-group">
                        <label for="zona">Zona</label>
                        <select id="zona" name="zona" required>
                            <option value="Norte"  <%= venta.zona === 'Norte'  ? 'selected' : '' %>>Norte</option>
                            <option value="Centro" <%= venta.zona === 'Centro' ? 'selected' : '' %>>Centro</option>
                            <option value="Sur"    <%= venta.zona === 'Sur'    ? 'selected' : '' %>>Sur</option>
                        </select>
                    </div>

                    <!-- Ubicación -->
                    <div class="input-row">
                        <div class="input-group">
                            <label for="entidad">Entidad / Edificio</label>
                            <input id="entidad" name="entidad" type="text"
                                   value="<%= venta.ubicacion.entidad %>" required>
                        </div>
                        <div class="input-group input-group-sm">
                            <label for="piso">Piso</label>
                            <input id="piso" name="piso" type="text"
                                   value="<%= venta.ubicacion.piso %>" required>
                        </div>
                    </div>

                    <!-- Cliente -->
                    <div class="input-group">
                        <label for="cliente">Cliente</label>
                        <input id="cliente" name="cliente" type="text"
                               value="<%= venta.cliente %>" required>
                    </div>

                    <!-- Producto -->
                    <div class="input-group">
                        <label for="producto">Producto</label>
                        <input id="producto" name="producto" type="text"
                               value="<%= venta.producto %>" required>
                    </div>

                    <!-- Precio y Cantidad -->
                    <div class="input-row">
                        <div class="input-group">
                            <label for="precioUnitario">Precio Unitario ($)</label>
                            <input id="precioUnitario" name="precioUnitario" type="number"
                                   step="0.01" min="0"
                                   value="<%= venta.precioUnitario %>" required
                                   oninput="calcularTotal()">
                        </div>
                        <div class="input-group">
                            <label for="cantidad">Cantidad</label>
                            <input id="cantidad" name="cantidad" type="number"
                                   min="1" value="<%= venta.cantidad %>" required
                                   oninput="calcularTotal()">
                        </div>
                    </div>

                    <!-- Total -->
                    <div class="input-group">
                        <label>Total (calculado automáticamente)</label>
                        <input id="totalMostrar" type="text" readonly class="input-readonly"
                               value="$<%= venta.total.toFixed(2) %>">
                        <input id="total" name="total" type="hidden" value="<%= venta.total %>">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary">
                            Actualizar Venta
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </main>

<script>
function calcularTotal() {
    const precio   = parseFloat(document.getElementById('precioUnitario').value) || 0;
    const cantidad = parseInt(document.getElementById('cantidad').value)          || 0;
    const total    = precio * cantidad;

    document.getElementById('totalMostrar').value = '$' + total.toFixed(2);
    document.getElementById('total').value        = total.toFixed(2);
}
</script>

</body>
</html>
