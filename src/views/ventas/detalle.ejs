<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <link rel="stylesheet" href="/css/styleIndex.css">
    <link rel="stylesheet" href="/css/styleApp.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="app-body">

    <%- include('../partials/navbar') -%>

    <main class="app-main">
        <div class="container">

            <a href="/ventas" class="back-link">
                <i class="fa-solid fa-arrow-left"></i> Volver al listado
            </a>

            <% if (mensaje) { %>
            <div class="alert-success"><i class="fa-solid fa-circle-check"></i> <%= mensaje %></div>
            <% } %>
            <% if (error) { %>
            <div class="alert-error"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
            <% } %>

            <%
                const iniciales = venta.cliente.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase();
                const saldo     = venta.saldo || 0;
            %>

            <!-- Header -->
            <div class="detalle-header">
                <div class="detalle-avatar"><%= iniciales %></div>
                <div class="detalle-info">
                    <h1><%= venta.cliente %></h1>
                    <p>
                        <span class="badge badge-<%= venta.zona.toLowerCase() %>"><%= venta.zona %></span>
                        &nbsp;·&nbsp;
                        <time><%= new Date(venta.fecha).toLocaleDateString('es-EC', { year:'numeric', month:'long', day:'numeric' }) %></time>
                        &nbsp;·&nbsp;
                        <span class="badge-<%= venta.estadoPago %>">
                            <% if (venta.estadoPago === 'pagado') { %><i class="fa-solid fa-circle-check"></i> Pagado
                            <% } else if (venta.estadoPago === 'parcial') { %><i class="fa-solid fa-clock"></i> Parcial
                            <% } else { %><i class="fa-solid fa-circle-xmark"></i> Pendiente<% } %>
                        </span>
                    </p>
                </div>
                <div class="detalle-acciones">
                    <a href="/ventas/editar/<%= venta._id %>" class="btn-primary">
                        <i class="fa-solid fa-pen"></i> Editar
                    </a>
                    <a href="/ventas" class="btn-secondary">Volver</a>
                </div>
            </div>

            <!-- KPIs -->
            <div class="kpis-fila">
                <div class="kpi-mini">
                    <div class="val">$<%= venta.total.toFixed(2) %></div>
                    <div class="lbl">Total facturado</div>
                </div>
                <div class="kpi-mini ok">
                    <div class="val">$<%= (venta.totalPagado || 0).toFixed(2) %></div>
                    <div class="lbl">Total cobrado</div>
                </div>
                <div class="kpi-mini <%= saldo > 0 ? 'warn' : 'ok' %>">
                    <div class="val">$<%= saldo.toFixed(2) %></div>
                    <div class="lbl">Saldo pendiente</div>
                </div>
            </div>

            <!-- Información general -->
            <div class="venta-section">
                <h2><i class="fa-solid fa-circle-info" style="color:#3498db"></i> Información general</h2>
                <div class="info-grid">
                    <div class="info-item"><label>Producto</label><span><%= venta.producto %></span></div>
                    <div class="info-item"><label>Cantidad</label><span><%= venta.cantidad %></span></div>
                    <div class="info-item"><label>Precio unitario</label><span>$<%= venta.precioUnitario.toFixed(2) %></span></div>
                    <div class="info-item"><label>Zona</label><span><%= venta.zona %></span></div>
                    <div class="info-item"><label>Entidad / Edificio</label><span><%= venta.ubicacion?.entidad || '—' %></span></div>
                    <div class="info-item"><label>Piso</label><span><%= venta.ubicacion?.piso || '—' %></span></div>
                    <div class="info-item"><label>Tipo</label><span><%= venta.tipoTransaccion || 'venta' %></span></div>
                    <div class="info-item"><label>Estado de entrega</label><span><%= venta.estadoEntrega || 'Inmediata' %></span></div>
                </div>
            </div>

            <!-- Ítems multi-producto -->
            <% if (venta.items && venta.items.length > 0) { %>
            <div class="venta-section">
                <h2><i class="fa-solid fa-list-ul" style="color:#8b5cf6"></i> Ítems del pedido (<%= venta.items.length %>)</h2>
                <div class="table-wrapper">
                    <table class="items-table">
                        <thead>
                            <tr><th>Producto</th><th>Cantidad</th><th>Precio unit.</th><th>Subtotal</th><th>Entrega</th></tr>
                        </thead>
                        <tbody>
                        <% venta.items.forEach(function(it) { %>
                            <tr>
                                <td><strong><%= it.nombre %></strong></td>
                                <td><%= it.cantidad %></td>
                                <td>$<%= (it.precio || 0).toFixed(2) %></td>
                                <td class="subtotal">$<%= (it.subtotal || it.cantidad * it.precio || 0).toFixed(2) %></td>
                                <td>
                                    <% if (it.entregado) { %>
                                        <span class="entregado-badge"><i class="fa-solid fa-check"></i> Entregado</span>
                                    <% } else { %>
                                        <span class="pendiente-badge">Pendiente</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" style="text-align:right;font-weight:bold;color:#7f8c8d;padding:10px 12px;">TOTAL:</td>
                                <td class="subtotal" style="padding:10px 12px;">$<%= venta.total.toFixed(2) %></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <% } %>

            <!-- Cobros registrados -->
            <% if (venta.cobros && venta.cobros.length > 0) { %>
            <div class="venta-section">
                <h2><i class="fa-solid fa-money-bill-wave" style="color:#10b981"></i> Cobros registrados (<%= venta.cobros.length %>)</h2>
                <div class="cobros-lista">
                <% venta.cobros.forEach(function(c) { %>
                    <div class="cobro-item">
                        <div>
                            <span class="cobro-monto">$<%= c.monto.toFixed(2) %></span>
                            &nbsp;·&nbsp;
                            <span class="cobro-meta">
                                <i class="fa-solid fa-<%= c.metodo === 'efectivo' ? 'money-bill' : c.metodo === 'transferencia' ? 'mobile-alt' : 'building-columns' %>"></i>
                                <%= c.metodo %>
                                <% if (c.referencia) { %> · Ref: <%= c.referencia %><% } %>
                                <% if (c.cobradoPor) { %> · Por: <%= c.cobradoPor %><% } %>
                            </span>
                        </div>
                        <time style="font-size:12px;color:#95a5a6;"><%= new Date(c.fecha).toLocaleDateString('es-EC') %></time>
                    </div>
                <% }) %>
                </div>
            </div>
            <% } %>

            <!-- Historial de ediciones -->
            <% if (venta.historialEdiciones && venta.historialEdiciones.length > 0) { %>
            <div class="venta-section">
                <h2><i class="fa-solid fa-clock-rotate-left" style="color:#f59e0b"></i> Historial de ediciones (<%= venta.historialEdiciones.length %>)</h2>
                <div class="historial-ediciones">
                <% venta.historialEdiciones.forEach(function(h) { %>
                    <div class="historial-edit-item">
                        <div class="h-fecha">
                            <%= new Date(h.fecha).toLocaleDateString('es-EC', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                            <% if (h.usuario) { %>&nbsp;·&nbsp;<%= h.usuario %><% } %>
                        </div>
                        <div class="h-motivo"><%= h.motivo || 'Edición registrada' %></div>
                    </div>
                <% }) %>
                </div>
            </div>
            <% } %>

            <!-- Acción cobrar -->
            <% if (venta.estadoPago !== 'pagado') { %>
            <div class="venta-section" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
                <div>
                    <strong style="color:#2c3e50;">Saldo pendiente:</strong>
                    <span style="font-size:20px;font-weight:bold;color:#e74c3c;margin-left:8px;">$<%= saldo.toFixed(2) %></span>
                </div>
                <button class="btn-primary" style="background:#10b981;"
                    onclick="abrirModalCobro('<%= venta._id %>','<%= venta.cliente %>','<%= venta.producto %>','<%= venta.total %>','<%= venta.totalPagado || 0 %>')">
                    <i class="fa-solid fa-money-bill-wave"></i> Registrar cobro
                </button>
            </div>
            <% } %>

        </div>
    </main>

    <!-- MODAL: REGISTRAR COBRO -->
    <div id="modalCobro" class="modal-overlay">
        <div class="modal-box">
            <h2><i class="fa-solid fa-money-bill-wave" style="color:#10b981"></i> Registrar cobro</h2>
            <p class="modal-sub" id="modal-sub"></p>
            <div class="modal-resumen">
                <p>Total: <strong id="modal-total">$0.00</strong></p>
                <p>Pagado: <strong id="modal-pagado">$0.00</strong></p>
                <p>Saldo: <span class="saldo" id="modal-saldo">$0.00</span></p>
            </div>
            <p class="modal-error" id="modal-error">El monto no puede superar el saldo pendiente.</p>
            <div class="modal-field">
                <label>Monto a cobrar ($)</label>
                <input type="number" id="input-monto" min="0.01" step="0.01" placeholder="0.00" oninput="validarMonto()">
            </div>
            <div class="modal-field">
                <label>Método de pago</label>
                <select id="input-metodo">
                    <option value="efectivo">Efectivo</option>
                    <option value="transferencia">Transferencia</option>
                    <option value="deposito">Depósito</option>
                </select>
            </div>
            <div class="modal-field">
                <label>Referencia <span style="color:#9ca3af;font-weight:400">(opcional)</span></label>
                <input type="text" id="input-referencia" placeholder="Nro. transacción, comprobante...">
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" onclick="cerrarModal()">Cancelar</button>
                <button class="btn-modal-confirm" id="btn-confirmar" onclick="ejecutarCobro()">
                    <i class="fa-solid fa-check"></i> Confirmar cobro
                </button>
            </div>
        </div>
    </div>

    <script>
    let _ventaId = '', _total = 0, _pagado = 0, _saldo = 0;
    function abrirModalCobro(id, cliente, producto, total, pagado) {
        _ventaId = id; _total = parseFloat(total); _pagado = parseFloat(pagado);
        _saldo   = Math.max(0, _total - _pagado);
        document.getElementById('modal-sub').textContent    = cliente + ' · ' + producto;
        document.getElementById('modal-total').textContent  = '$' + _total.toFixed(2);
        document.getElementById('modal-pagado').textContent = '$' + _pagado.toFixed(2);
        document.getElementById('modal-saldo').textContent  = '$' + _saldo.toFixed(2);
        document.getElementById('input-monto').value        = _saldo.toFixed(2);
        document.getElementById('input-referencia').value   = '';
        document.getElementById('modal-error').style.display = 'none';
        document.getElementById('btn-confirmar').disabled   = false;
        document.getElementById('modalCobro').classList.add('active');
    }
    function cerrarModal() { document.getElementById('modalCobro').classList.remove('active'); }
    function validarMonto() {
        const monto = parseFloat(document.getElementById('input-monto').value) || 0;
        const ok    = monto > 0 && monto <= _saldo + 0.001;
        document.getElementById('modal-error').style.display = ok ? 'none' : 'block';
        document.getElementById('btn-confirmar').disabled    = !ok;
    }
    async function ejecutarCobro() {
        const monto = parseFloat(document.getElementById('input-monto').value);
        const metodo = document.getElementById('input-metodo').value;
        const referencia = document.getElementById('input-referencia').value.trim();
        const btn = document.getElementById('btn-confirmar');
        btn.disabled = true; btn.textContent = 'Guardando...';
        try {
            const resp = await fetch('/ventas/cobrar/' + _ventaId, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ monto, metodo, referencia })
            });
            const data = await resp.json();
            if (resp.ok && data.ok) { cerrarModal(); window.location.href = '/ventas/detalle/' + _ventaId + '?ok=1'; }
            else { alert('Error: ' + (data.error || 'No se pudo registrar.')); btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirmar cobro'; }
        } catch (e) { alert('Error de conexión.'); btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirmar cobro'; }
    }
    document.getElementById('modalCobro').addEventListener('click', e => { if (e.target === e.currentTarget) cerrarModal(); });
    </script>

</body>
</html>
