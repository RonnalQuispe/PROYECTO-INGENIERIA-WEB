<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdminExpress - Nueva Venta</title>
    <link rel="stylesheet" href="/css/styleApp.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="app-body">

    <%- include('../partials/navbar') %>

    <main class="app-main">
        <div class="container container-sm">

            <div class="page-header">
                <h1> Nueva Venta</h1>
                <a href="/ventas" class="btn-secondary">← Volver al listado</a>
            </div>

            <% if (error) { %>
                <div class="alert-error"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
            <% } %>

            <div class="form-card">
                <form action="/ventas/guardar" method="POST">

                    <!-- Zona -->
                    <div class="input-group">
                        <label for="zona">Zona</label>
                        <select id="zona" name="zona" required>
                            <option value="">-- Selecciona una zona --</option>
                            <option value="Norte">Norte</option>
                            <option value="Centro">Centro</option>
                            <option value="Sur">Sur</option>
                        </select>
                    </div>

                    <!-- Ubicación -->
                    <div class="input-row">
                        <div class="input-group">
                            <label for="entidad">Entidad / Edificio</label>
                            <input id="entidad" name="entidad" type="text" placeholder="Ej: Edificio Central" required>
                        </div>
                        <div class="input-group input-group-sm">
                            <label for="piso">Piso</label>
                            <input id="piso" name="piso" type="text" placeholder="Ej: 3" required>
                        </div>
                    </div>

                    <!-- Cliente -->
                    <div class="input-group">
                        <label for="cliente">Cliente</label>
                        <input id="cliente" name="cliente" type="text" placeholder="Nombre del cliente" required>
                    </div>

                    <!-- Producto -->
                    <div class="input-group">
                        <label for="producto">Producto</label>
                        <input id="producto" name="producto" type="text" placeholder="Nombre del producto" required>
                    </div>

                    <!-- Precio y Cantidad -->
                    <div class="input-row">
                        <div class="input-group">
                            <label for="precioUnitario">Precio Unitario ($)</label>
                            <input id="precioUnitario" name="precioUnitario" type="number"
                                   step="0.01" min="0" placeholder="0.00" required
                                   oninput="calcularTotal()">
                        </div>
                        <div class="input-group">
                            <label for="cantidad">Cantidad</label>
                            <input id="cantidad" name="cantidad" type="number"
                                   min="1" placeholder="1" required
                                   oninput="calcularTotal()">
                        </div>
                    </div>

                    <!-- Total -->
                    <div class="input-group">
                        <label for="total">Total (calculado automáticamente)</label>
                        <input id="totalMostrar" type="text" placeholder="$0.00" readonly class="input-readonly">
                        <input id="total" name="total" type="hidden" value="0">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary btn-full">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar Venta
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </main>

<script>
function calcularTotal() {
    const precio   = parseFloat(document.getElementById('precioUnitario').value) || 0;
    const cantidad = parseInt(document.getElementById('cantidad').value)          || 0;
    const total    = precio * cantidad;

    document.getElementById('totalMostrar').value = '$' + total.toFixed(2);
    document.getElementById('total').value        = total.toFixed(2);
}
</script>

</body>
</html>
