<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdminExpress - Ventas</title>
    <link rel="stylesheet" href="/css/styleIndex.css">
    <link rel="stylesheet" href="/css/styleApp.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="app-body">

    <%- include('../partials/navbar') %>

    
            
    <main class="app-main">
        <div class="container">

            <div class="page-header">
                <h1><i class="fa-solid fa-list"></i> Registro de Ventas</h1>
                <a href="/ventas/crear" class="btn-primary">Nueva Venta</a>
            </div>

            <!-- FILTROS -->
            <div class="filter-box">
                <h3><i class="fa-solid fa-filter"></i> Filtrar por:</h3>
                <form action="/ventas" method="GET" class="filter-form">
                    <div class="filter-group">
                        <label>Zona</label>
                        <select name="zona">
                            <option value="">Todas las zonas</option>
                            <option value="Norte"  <%= filtros.zona === 'Norte'  ? 'selected' : '' %>>Norte</option>
                            <option value="Centro" <%= filtros.zona === 'Centro' ? 'selected' : '' %>>Centro</option>
                            <option value="Sur"    <%= filtros.zona === 'Sur'    ? 'selected' : '' %>>Sur</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Cliente</label>
                        <input type="text" name="cliente" placeholder="Buscar cliente..." value="<%= filtros.cliente %>">
                    </div>
                    <div class="filter-group">
                        <label>Estado de pago</label>
                        <select name="estadoPago">
                            <option value="">Todos</option>
                            <option value="pendiente" <%= filtros.estadoPago === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                            <option value="parcial"   <%= filtros.estadoPago === 'parcial'   ? 'selected' : '' %>>Parcial</option>
                            <option value="pagado"    <%= filtros.estadoPago === 'pagado'    ? 'selected' : '' %>>Pagado</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-primary">Buscar</button>
                    <a href="/ventas" class="btn-secondary">Limpiar</a>
                </form>
            </div>

            <!-- TABLA -->
            <% if (ventas.length === 0) { %>
                <div class="empty-state">
                    <i class="fa-solid fa-box-open"></i>
                    <p>No se encontraron ventas con esos filtros.</p>
                    <a href="/ventas/crear" class="btn-primary">Registrar primera venta</a>
                </div>
            <% } else { %>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Zona</th>
                                <th>Ubicación</th>
                                <th>Cliente</th>
                                <th>Producto</th>
                                <th>P. Unit.</th>
                                <th>Cant.</th>
                                <th>Total</th>
                                <th>Pagado</th>
                                <th>Saldo</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% ventas.forEach(venta => {
                                const estadoPago  = venta.estadoPago  || 'pendiente';
                                const totalPagado = venta.totalPagado || 0;
                                const saldo       = Math.max(0, venta.total - totalPagado);
                            %>
                            <tr>
                                <td><%= new Date(venta.fecha).toLocaleDateString('es-EC') %></td>
                                <td><span class="badge badge-<%= venta.zona.toLowerCase() %>"><%= venta.zona %></span></td>
                                <td><%= venta.ubicacion.entidad %> - Piso <%= venta.ubicacion.piso %></td>
                                <td><%= venta.cliente %></td>
                                <td><%= venta.producto %></td>
                                <td>$<%= venta.precioUnitario.toFixed(2) %></td>
                                <td><%= venta.cantidad %></td>
                                <td class="total-cell">$<%= venta.total.toFixed(2) %></td>
                                <td class="total-cell">$<%= totalPagado.toFixed(2) %></td>
                                <td class="total-cell <%= saldo > 0 ? 'saldo-deuda' : 'saldo-ok' %>">
                                    $<%= saldo.toFixed(2) %>
                                </td>
                                <td>
                                    <span class="badge-<%= estadoPago %>">
                                        <% if (estadoPago === 'pagado') { %><i class="fa-solid fa-circle-check"></i> Pagado
                                        <% } else if (estadoPago === 'parcial') { %><i class="fa-solid fa-clock"></i> Parcial
                                        <% } else { %><i class="fa-solid fa-circle-xmark"></i> Pendiente<% } %>
                                    </span>
                                    <% if ((venta.cobros || []).length > 0) { %>
                                    <br>
                                    <button class="historial-toggle" onclick="toggleHistorial('<%= venta._id %>')">
                                        ver cobros (<%= venta.cobros.length %>)
                                    </button>
                                    <div class="historial-panel" id="hist-<%= venta._id %>">
                                        <% venta.cobros.forEach(c => { %>
                                        <div class="historial-item">
                                            <strong>$<%= c.monto.toFixed(2) %></strong> ·
                                            <%= c.metodo %> ·
                                            <%= new Date(c.fecha).toLocaleDateString('es-EC') %>
                                            <% if (c.referencia) { %> · Ref: <%= c.referencia %><% } %>
                                        </div>
                                        <% }) %>
                                    </div>
                                    <% } %>
                                </td>
                                <td class="actions-cell">
                                    <a href="/ventas/detalle/<%= venta._id %>" class="btn-ver" title="Ver detalle">
                                        <i class="fa-solid fa-eye"></i> Ver
                                    </a>
                                    <% if (estadoPago !== 'pagado') { %>
                                    <button class="btn-cobrar"
                                        onclick="abrirModalCobro('<%= venta._id %>','<%= venta.cliente %>','<%= venta.producto %>','<%= venta.total %>','<%= totalPagado %>')"
                                        title="Registrar cobro">
                                        <i class="fa-solid fa-money-bill-wave"></i> Cobrar
                                    </button>
                                    <% } %>
                                    <a href="/ventas/editar/<%= venta._id %>" class="btn-edit" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a href="/ventas/eliminar/<%= venta._id %>" class="btn-delete"
                                       title="Eliminar"
                                       onclick="return confirm('¿Eliminar esta venta?')">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                        <tfoot>
                            <tr class="gran-total-row">
                                <td colspan="7" class="text-right"><strong>GRAN TOTAL:</strong></td>
                                <td class="total-cell"><strong>$<%= granTotal.toFixed(2) %></strong></td>
                                <td colspan="4"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <p class="results-count">
                    <i class="fa-solid fa-circle-info"></i>
                    Mostrando <strong><%= ventas.length %></strong> venta(s)
                </p>
            <% } %>

        </div>
    </main>

    
    <!-- MODAL: REGISTRAR COBRO -->
    <div class="modal-overlay" id="modalCobro">
        <div class="modal-box">
            <h2><i class="fa-solid fa-money-bill-wave" style="color:#10b981"></i> Registrar cobro</h2>
            <p class="modal-sub" id="modal-sub">Cliente · Producto</p>
            <div class="modal-resumen">
                <p>Total de la venta: <strong id="modal-total">$0.00</strong></p>
                <p>Ya pagado: <strong id="modal-pagado">$0.00</strong></p>
                <p>Saldo pendiente: <span class="saldo" id="modal-saldo">$0.00</span></p>
                <p>morosidad: <span class="morosidad" id="modal-morosidad">0.00</span></p>
                
            </div>
            <p class="modal-error" id="modal-error">El monto no puede superar el saldo pendiente.</p>
            <div class="modal-field">
                <label>Monto a cobrar ($)</label>
                <input type="number" id="input-monto" min="0.01" step="0.01" placeholder="0.00" oninput="validarMonto()">
            </div>
            <div class="modal-field">
                <label>Método de pago</label>
                <select id="input-metodo">
                    <option value="efectivo">Efectivo</option>
                    <option value="transferencia">Transferencia</option>
                    <option value="deposito">Depósito</option>
                </select>
            </div>
            <div class="modal-field">
                <label>Referencia <span style="color:#9ca3af;font-weight:400">(opcional)</span></label>
                <input type="text" id="input-referencia" placeholder="Nro. transacción, comprobante...">
            </div>
            <div class="modal-footer">
                <button class="btn-modal-cancel" onclick="cerrarModal()">Cancelar</button>
                <button class="btn-modal-confirm" id="btn-confirmar" onclick="confirmarCobro()">
                    <i class="fa-solid fa-check"></i> Confirmar cobro
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: DOBLE CONFIRMACIÓN -->
    <div class="confirm-overlay" id="confirmTotal">
        <div class="confirm-box">
            <div class="confirm-icon">✅</div>
            <h3>¿Marcar como PAGADO?</h3>
            <p>Este monto cubre el saldo completo.<br>La venta quedará cerrada como <strong>Pagada</strong>.</p>
            <div class="confirm-footer">
                <button class="btn-confirm-no"  onclick="cancelarConfirm()">No, volver</button>
                <button class="btn-confirm-yes" onclick="ejecutarCobro()">Sí, marcar como pagado</button>
            </div>
        </div>
    </div>

    <script>
    let _ventaId = '', _total = 0, _pagado = 0, _saldo = 0;

    function abrirModalCobro(id, cliente, producto, total, pagado) {
        _ventaId = id; _total = parseFloat(total); _pagado = parseFloat(pagado);
        _saldo   = Math.max(0, _total - _pagado);
        document.getElementById('modal-sub').textContent    = cliente + ' · ' + producto;
        document.getElementById('modal-total').textContent  = '$' + _total.toFixed(2);
        document.getElementById('modal-pagado').textContent = '$' + _pagado.toFixed(2);
        document.getElementById('modal-saldo').textContent  = '$' + _saldo.toFixed(2);
        document.getElementById('input-monto').value        = _saldo.toFixed(2);
        document.getElementById('input-monto').max          = _saldo;
        document.getElementById('input-referencia').value   = '';
        document.getElementById('modal-error').style.display = 'none';
        document.getElementById('btn-confirmar').disabled   = false;
        document.getElementById('modalCobro').classList.add('active');
    }
    function cerrarModal() { document.getElementById('modalCobro').classList.remove('active'); }
    function validarMonto() {
        const monto = parseFloat(document.getElementById('input-monto').value) || 0;
        const ok    = monto > 0 && monto <= _saldo + 0.001;
        document.getElementById('modal-error').style.display = ok ? 'none' : 'block';
        document.getElementById('btn-confirmar').disabled    = !ok;
    }
    function confirmarCobro() {
        const monto = parseFloat(document.getElementById('input-monto').value) || 0;
        if (monto <= 0 || monto > _saldo + 0.001) return;
        if (Math.abs(monto - _saldo) < 0.001) {
            cerrarModal();
            document.getElementById('confirmTotal').classList.add('active');
        } else { ejecutarCobro(); }
    }
    function cancelarConfirm() {
        document.getElementById('confirmTotal').classList.remove('active');
        document.getElementById('modalCobro').classList.add('active');
    }
    async function ejecutarCobro() {
        document.getElementById('confirmTotal').classList.remove('active');
        const monto      = parseFloat(document.getElementById('input-monto').value);
        const metodo     = document.getElementById('input-metodo').value;
        const referencia = document.getElementById('input-referencia').value.trim();
        try {
            const resp = await fetch('/ventas/cobrar/' + _ventaId, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ monto, metodo, referencia })
            });
            if (resp.ok) { window.location.reload(); }
            else { const d = await resp.json(); alert('Error: ' + (d.error || 'No se pudo registrar.')); }
        } catch (e) { alert('Error de conexión.'); }
    }
    function toggleHistorial(id) { document.getElementById('hist-' + id).classList.toggle('open'); }
    document.getElementById('modalCobro').addEventListener('click', e => { if (e.target === e.currentTarget) cerrarModal(); });
    </script>

</body>
</html>
