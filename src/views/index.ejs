<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <link rel="stylesheet" href="/css/styleIndex.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="login-body">

    <div class="login-wrapper">
        <div class="login-card">

            <div class="login-brand">
                <i class="fa-solid fa-boxes-stacking"></i>
                <h1>Sistema Jalej</h1>
                <p>Gestión de ventas y cartera</p>
            </div>

            <% if (error) { %>
            <div class="login-error">
                <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
            </div>
            <% } %>

            <form action="/login" method="POST" class="login-form">
                <div class="login-field">
                    <label for="usuario"><i class="fa-solid fa-user"></i> Usuario</label>
                    <input id="usuario" type="text" name="usuario"
                           placeholder="Ingresa tu usuario"
                           autocomplete="username" required>
                </div>
                <div class="login-field">
                    <label for="contrasena"><i class="fa-solid fa-lock"></i> Contraseña</label>
                    <input id="contrasena" type="password" name="contrasena"
                           placeholder="Ingresa tu contraseña"
                           autocomplete="current-password" required>
                </div>
                <button type="submit" class="login-btn">
                    <i class="fa-solid fa-right-to-bracket"></i> Entrar
                </button>
            </form>

        </div>
    </div>

</body>
</html>
